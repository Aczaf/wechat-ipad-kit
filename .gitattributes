# 统一换行符：Windows 检出时不要把 shell 脚本转成 CRLF
# （CRLF 会让 Linux 上的 bash 报 "bad interpreter" 或 "\r: command not found"）
* text=auto eol=lf

*.sh    text eol=lf
*.bash  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
Dockerfile text eol=lf

# 二进制文件不做转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.xz    binary
*.so    binary
